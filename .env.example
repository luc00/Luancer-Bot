# GEMINI_API_KEY: Required for server-side Gemini AI API calls (/api/market-research).
# Never expose this key in client-side VITE_ variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DOMAIN_VERIFY_SECRET: 32+ byte random HMAC secret for signing domain ownership challenges.
DOMAIN_VERIFY_SECRET="REPLACE_WITH_RANDOM_64_CHAR_HEX_SECRET"

# APP_URL: The public URL where this applet is hosted.
APP_URL="MY_APP_URL"

# FIREBASE_PROJECT_ID: Optional override for Firebase Admin SDK when firebase-applet-config.json is absent.
FIREBASE_PROJECT_ID="MY_FIREBASE_PROJECT_ID"

# Client-side Firebase Web Config (used when firebase-applet-config.json is excluded from Git)
VITE_FIREBASE_API_KEY="MY_RESTRICTED_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="MY_PROJECT.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="MY_FIREBASE_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="MY_PROJECT.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="MY_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="MY_FIREBASE_APP_ID"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="MY_FIRESTORE_DATABASE_ID"
